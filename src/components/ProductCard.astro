---
const { data } = Astro.props;
---

<section class="productList">
  <article class="smallProduct" product.soldout ? "sold-out_container">
    <img
      src=`https://kea-alt-del.dk/t7/images/webp/640/${data.id}.webp`
      alt="trøje"
    />
    <p>{data.productdisplayname}</p>
    <p>DKK {data.price} <span class={data.discount && "onsale"}></span>,-</p>

    {data.discount && 
    <p>Now DKK {Math.round (data.price - data.price * data.dicount / 100)}</p>
    <span class="tilbud">{data.discount}%</span>}
    
  <a class="read_more" href="product.html">Gå til produkt</a>
  </article>
</section>
